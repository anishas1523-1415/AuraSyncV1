# Copy to .env next to docker-compose.yml. Never commit the real .env.

# Exactly 16 letters/digits. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(12).toString('base64').replace(/[^a-zA-Z0-9]/g,'').slice(0,16))"
# Use the SAME value as AURASYNQ_COMPANION_SECRET in AuraSynq's environment.
SERVER_SECRET_KEY=

# Only for `docker compose --profile tunnel up -d` (Cloudflare Zero Trust > Networks > Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=
